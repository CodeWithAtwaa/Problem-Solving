{"name":"Z. Clean Code","group":"Codeforces - Sheet #4 (Strings)","url":"https://codeforces.com/group/MWSDmqGsZm/contest/219856/problem/Z","interactive":false,"memoryLimit":256,"timeLimit":1000,"tests":[{"id":1758439210233,"input":"// I am a single comment and you must remove me :((\n/*\nI am a block comment and you must remove me\n*/\n\n#include<iostream>\nusing namespace std;\n\nint main() {\n\nint a, b;\ncin » a » b; // Reading two variables from user (please remove me!! :( )\ncout « a + b « endl;\n\n// End of the program (remove me please :))\nreturn 0;\n\n}\n","output":"#include<iostream>\nusing namespace std;\nint main() {\nint a, b;\ncin » a » b;\ncout « a + b « endl;\nreturn 0;\n}\n"},{"id":1758439729761,"input":"#include <iostream>\n#include <string>\nusing namespace std;\n\nint main() {\n    string line;\n    bool inBlock = false;\n\n    while (getline(cin, line)) {\n        string result = \"\";\n        for (int i = 0; i < (int)line.size();) {\n            if (!inBlock && i + 1 < line.size() && line[i] == '/' && line[i + 1] == '/') {\n                // single-line comment → ignore rest of line\n                break;\n            } \n            else if (!inBlock && i + 1 < line.size() && line[i] == '/' && line[i + 1] == '*') {\n                // start of block comment\n                inBlock = true;\n                i += 2;\n            } \n            else if (inBlock && i + 1 < line.size() && line[i] == '*' && line[i + 1] == '/') {\n                // end of block comment\n                inBlock = false;\n                i += 2;\n            } \n            else if (inBlock) {\n                // skip characters inside block comment\n                i++;\n            } \n            else {\n                // normal character\n                result += line[i];\n                i++;\n            }\n        }\n\n        // trim spaces\n        int start = 0;\n        while (start < result.size() && isspace(result[start])) start++;\n        int end = result.size() - 1;\n        while (end >= 0 && isspace(result[end])) end--;\n\n        if (start <= end) {\n            cout << result.substr(start, end - start + 1) << \"\\n\";\n        }\n    }\n    return 0;\n}\n","output":"#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\nstring line;\nbool inBlock = false;\nwhile (getline(cin, line)) {\nstring result = \"\";\nfor (int i = 0; i < (int)line.size();) {\nif (!inBlock && i + 1 < line.size() && line[i] == '/' && line[i + 1] == '/') {\nbreak;\n}\nelse if (!inBlock && i + 1 < line.size() && line[i] == '/' && line[i + 1] == '*') {\ninBlock = true;\ni += 2;\n}\nelse if (inBlock && i + 1 < line.size() && line[i] == '*' && line[i + 1] == '/') {\ninBlock = false;\ni += 2;\n}\nelse if (inBlock) {\ni++;\n}\nelse {\nresult += line[i];\ni++;\n}\n}\nint start = 0;\nwhile (start < result.size() && isspace(result[start])) start++;\nint end = result.size() - 1;\nwhile (end >= 0 && isspace(result[end])) end--;\nif (start <= end) {\ncout << result.substr(start, end - start + 1) << \"\\n\";\n}\n}\nreturn 0;\n}\n"},{"id":1758439734019,"input":"","output":""},{"id":1758441118181,"input":"#include <iostream>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int N;\n    cin >> N;\n\n    int freq[26] = {0};\n    char c;\n\n    for (int i = 0; i < N; i++) {\n        cin >> c;        // نقرأ حرف واحد فقط\n        freq[c - 'a']++; // نزود التكرار\n    }\n\n    // اطبع الحروف بالترتيب\n    for (int i = 0; i < 26; i++) {\n        while (freq[i]--) {\n            cout << char('a' + i);\n        }\n    }\n\n    return 0;\n}\n","output":"#include <iostream>\nusing namespace std;\nint main() {\nios::sync_with_stdio(false);\ncin.tie(nullptr);\nint N;\ncin >> N;\nint freq[26] = {0};\nchar c;\nfor (int i = 0; i < N; i++) {\ncin >> c;\nfreq[c - 'a']++;\n}\nfor (int i = 0; i < 26; i++) {\nwhile (freq[i]--) {\ncout << char('a' + i);\n}\n}\nreturn 0;\n}\n"}],"testType":"single","input":{"type":"stdin"},"output":{"type":"stdout"},"languages":{"java":{"mainClass":"Main","taskClass":"ZCleanCode"}},"batch":{"id":"2dcbbf70-a7e1-46ac-a811-83bdec3936fd","size":1},"srcPath":"c:\\Users\\SOFT ZONE\\OneDrive - Faculty of Computers and Information Technology (Zagazig University)\\Desktop\\problemSolving\\NewComers\\Sheet4\\Z_Clean_Code.cpp"}